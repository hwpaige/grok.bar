#!/usr/bin/env bash
# Wrap stock omarchy-launch-tui so Grok always opens in a zero-padding terminal.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STOCK="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-launch-tui"

app_id=""
if [[ ${1:-} == --app-id=* ]]; then
  app_id="${1#--app-id=}"
  shift
fi

cmd="${1:-}"
base="$(basename -- "$cmd" 2>/dev/null || true)"

if [[ $base == grok ]]; then
  shift
  exec "$SCRIPT_DIR/omarchy-grok-term" --cwd "${PWD}" -- "$@"
fi

if [[ ! -x $STOCK ]]; then
  echo "omarchy-launch-tui: stock launcher not found at $STOCK" >&2
  exit 1
fi

if [[ -n $app_id ]]; then
  exec "$STOCK" "--app-id=$app_id" "$@"
fi
exec "$STOCK" "$@"
